{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "BackgroundService.Services": "Information"
    }
  },
  "AllowedHosts": "*",
  "BackgroundServices": {
    "TimedTask": {
      "Enabled": true,
      "IntervalSeconds": 5
    },
    "DataSync": {
      "Enabled": true,
      "IntervalHours": 1
    },
    "Queue": {
      "Capacity": 100,
      "MaxConcurrency": 10
    },
    "EmailSender": {
      "MaxRetries": 3,
      "RetryDelayMs": [1000, 5000, 15000]
    }
  }
}
